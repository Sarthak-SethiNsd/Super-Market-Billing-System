# ==============================================================================
# Supermarket Billing & Inventory Management System - Backend Configuration
# ==============================================================================
# IMPORTANT:
#   The C++ server executable (supermarket_server.exe) reads process environment
#   variables directly via std::getenv(); it does NOT automatically parse a
#   .env file from disk. Load these variables into your PowerShell/shell
#   environment (or use ../start-app.ps1) before starting the backend.

# Server Network Settings
PORT=8080
HOST=0.0.0.0

# CORS Configuration (Origin allowed by Crow CORS middleware; single origin)
CORS_ALLOWED_ORIGIN=http://localhost:5173

# SQLite Database File Location (relative to backend working directory or absolute path)
DB_PATH=data/supermarket.db

# Initial Administrator Password
# REQUIRED when initializing a fresh SQLite database that has no ADMIN user yet.
# Minimum length enforced by backend: 6 characters (use a strong 12+ character passphrase).
# If omitted or empty on a fresh database, NO admin account is created and
# POST /api/auth/admin/unlock will return HTTP 503 until initialized with an
# admin password in a clean/updated environment.
# Once an admin account exists in the SQLite `users` table, subsequent restarts
# ignore this variable and do not overwrite the stored PBKDF2 password hash.
ADMIN_INITIAL_PASSWORD=ReplaceWithYourStrongPassword

# Admin Session Token Lifetime in seconds (positive integer; e.g. 3600 = 1 hour)
# Note: Active bearer tokens live only in backend memory and are invalidated when
# the server restarts.
SESSION_DURATION_SECONDS=3600
